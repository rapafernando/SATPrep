# Copy this file to ".env" and fill in the values marked CHANGE.
# Never share the .env file or commit it anywhere.

# --- Names ---
APP_NAME=ScorePath
TIME_ZONE=America/New_York

# --- Web address ---
# CHANGE: your DuckDNS name for this app (no https:// in ALLOWED_HOSTS)
ALLOWED_HOSTS=scorepath.YOURNAME.duckdns.org
CSRF_TRUSTED_ORIGINS=https://scorepath.YOURNAME.duckdns.org
# Local port on the server that Caddy forwards to
WEB_PORT=8010
# 127.0.0.1 = reachable only from the server itself (safe, used with Caddy).
# For a quick test from another device on your home network, set 0.0.0.0, HTTPS_ONLY=False,
# and add the server's LAN address to ALLOWED_HOSTS. Set it back afterwards.
WEB_BIND=127.0.0.1
# Keep True when people use the https:// address. Set False ONLY to test over plain
# http on your home network (e.g. http://192.168.1.50:8010).
HTTPS_ONLY=True

# --- Secrets ---
# CHANGE: generate with:  openssl rand -base64 48
SECRET_KEY=
# CHANGE: use only letters and digits. Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=scorepath
POSTGRES_USER=scorepath

# --- First admin account (created on first start; the password is NOT changed later) ---
DJANGO_SUPERUSER_USERNAME=admin
# CHANGE: at least 8 characters, not common
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Optional ---
# Load the 24 sample questions on first start (1 = yes, 0 = no)
SEED_CONTENT=1
# Where the Django admin lives. Change to something private if you like, e.g. manage-7f3k/
ADMIN_URL=admin/
# Bump this number to make phones fetch fresh files after an update
APP_VERSION=1
LOG_LEVEL=INFO
# After you have used the https address for a few days without problems, set this to 31536000
# (one year) so browsers refuse plain http for the site. Leave 0 until then; it is hard to undo.
HSTS_SECONDS=0
DEBUG=False
